# Copy to .env and fill in. Never commit the real .env (already in .gitignore).
# Every var here is optional at the code level -- missing ones cause that
# tier/collector to be skipped with a logged reason, not a crash. Nothing
# runs "live" (real classification, real email, real social collectors)
# until the relevant vars are actually set.

# --- Phase 2: classification (Gemini -> Groq -> rules fallback chain) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Phase 2: email digest ---
# Gmail: use an App Password (requires 2FA on the account), not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_FROM_EMAIL=
DIGEST_TO_EMAIL=tylerherman19@gmail.com

# --- Phase 3: social collectors ---
# Reddit: create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=media-monitor/1.0 (by /u/your_username)

# YouTube Data API: create a key in Google Cloud Console, enable "YouTube Data API v3"
YOUTUBE_API_KEY=

# Currents API: general-news backup/recall source, free tier (1,000 req/day,
# no card, commercial use OK). Sign up at https://currentsapi.services/en/register
CURRENTS_API_KEY=

# Bluesky: checked empirically -- public searchPosts is 403'd for
# unauthenticated requests (unlike other public read endpoints), so this
# collector is a no-op without an app password. Create one at
# https://bsky.app/settings/app-passwords (do not use your real password).
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Meta Ad Library: requires a Meta developer app + identity-verified access
# token with ads_read permission (political ad transparency requires this).
META_AD_LIBRARY_TOKEN=
