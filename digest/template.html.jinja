<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
  body { font-family: -apple-system, Helvetica, Arial, sans-serif; background: #f4f4f5; margin: 0; padding: 0; color: #1a1a1a; }
  .container { max-width: 680px; margin: 0 auto; padding: 24px 16px; }
  h1 { font-size: 20px; margin: 0 0 4px; }
  .subtitle { color: #6b7280; font-size: 13px; margin-bottom: 24px; }
  .candidate { background: #ffffff; border: 1px solid #e5e7eb; border-radius: 8px; margin-bottom: 20px; overflow: hidden; }
  .candidate-header { padding: 12px 16px; border-bottom: 1px solid #e5e7eb; background: #fafafa; }
  .candidate-header h2 { font-size: 15px; margin: 0; }
  .candidate-header .office { color: #6b7280; font-size: 12px; }
  .spike { display: inline-block; margin-left: 8px; padding: 2px 8px; border-radius: 999px; background: #fee2e2; color: #b91c1c; font-size: 11px; font-weight: 600; }
  .item { padding: 12px 16px; border-bottom: 1px solid #f0f0f0; }
  .item:last-child { border-bottom: none; }
  .item a { color: #1d4ed8; text-decoration: none; font-weight: 600; font-size: 14px; }
  .item .meta { color: #6b7280; font-size: 12px; margin-top: 2px; }
  .badges { margin-top: 6px; }
  .badge { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 11px; margin-right: 4px; background: #eef2ff; color: #3730a3; }
  .badge.risk-elevated, .badge.risk-high { background: #fee2e2; color: #b91c1c; }
  .empty { padding: 16px; color: #6b7280; font-size: 13px; }
  .footer { color: #9ca3af; font-size: 11px; margin-top: 16px; }
</style>
</head>
<body>
<div class="container">
  <h1>Candidate Research Monitor</h1>
  <div class="subtitle">Daily digest &mdash; generated {{ generated_at }}</div>

  {% for candidate in candidates %}
  {% set items = items_by_candidate.get(candidate.id, []) %}
  {% set v = velocity.get(candidate.id, {}) %}
  <div class="candidate">
    <div class="candidate-header">
      <h2>{{ candidate.name }}
        {% if v.get('spike') %}<span class="spike">SPIKE: {{ v.get('today') }} today vs {{ v.get('baseline_mean') }} avg</span>{% endif %}
      </h2>
      <div class="office">{{ candidate.office }}</div>
    </div>
    {% if items %}
      {% for item in items %}
      <div class="item">
        <a href="{{ item.source_url }}">{{ item.title }}</a>
        <div class="meta">
          {{ item.source or 'unknown source' }} &middot; {{ (item.published_at or '')[:10] }} &middot; {{ item.collector }}
          {% if item.cluster_size and item.cluster_size > 1 %} &middot; in {{ item.cluster_size }} outlets{% endif %}
        </div>
        <div class="badges">
          <span class="badge">{{ item.topic }}</span>
          <span class="badge">{{ item.stance_toward_candidate }}</span>
          <span class="badge risk-{{ item.risk_level }}">{{ item.risk_level }}</span>
          {% if item.narrative_frame %}<span class="badge">{{ item.narrative_frame }}</span>{% endif %}
        </div>
      </div>
      {% endfor %}
    {% else %}
      <div class="empty">No new hits today.{% if rejected_counts.get(candidate.id) %} ({{ rejected_counts[candidate.id] }} rejected -- see data/rejections-*.jsonl){% endif %}</div>
    {% endif %}
  </div>
  {% endfor %}

  <div class="footer">Candidate Research Monitor &middot; classification tier (gemini/groq/rules) logged per item in the JSONL store</div>
</div>
</body>
</html>
